@import url("https://api.fontshare.com/v2/css?f[]=switzer@400,500&display=swap");

:root {
  --bg: #f5f4f0;
  --fg: #111111;
  --muted: #8a8a85;
  --rule: #dcdbd4;
  --accent: #111111;
  --sans: "Switzer", -apple-system, BlinkMacSystemFont, "Helvetica Neue",
    Arial, sans-serif;
  --mono: "Switzer", ui-monospace, "SF Mono", Menlo, Consolas, monospace;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html,
body {
  background: var(--bg);
  color: var(--fg);
  font-family: var(--sans);
  font-size: 16px;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
  cursor: none;
}

.custom-cursor {
  position: fixed;
  width: 24px;
  height: 24px;
  background: var(--fg);
  border-radius: 50%;
  pointer-events: none;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 10px;
  font-weight: 500;
  color: var(--bg);
  transition: width 0.2s, height 0.2s;
  transform: translate(-50%, -50%);
}

.custom-cursor.active {
  width: 70px;
  height: 70px;
  color: white;
  font-size: 13px;
}

a {
  color: inherit;
  text-decoration: none;
}

a:hover {
  opacity: 0.6;
}

.page {
  max-width: 1320px;
  margin: 0 auto;
  padding: 0 32px 64px;
  display: flex;
  flex-direction: column;
  gap: 96px;
  min-height: 100vh;
  transition: opacity 0.6s ease;
  opacity: 0;
  margin-top: 96px;
}

.page.ready,
.page.transitioning {
  opacity: 1;
}

.page.transitioning {
  opacity: 0;
}

/* Header */
.site-header {
  width: 100%;
  border-bottom: 1px solid #e5e5e5;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  background: var(--bg);
  transition: padding 0.3s ease, backdrop-filter 0.3s ease, background 0.3s ease;
}

.site-header.scrolled {
  padding: 12px 32px;
  background: rgba(245, 244, 240, 0.7);
  backdrop-filter: blur(10px);
  border-bottom: 1px solid rgba(220, 219, 212, 0.5);
}

.site-header-inner {
  max-width: 1320px;
  margin: 0 auto;
  padding: 32px;
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 24px;
  transition: padding 0.3s ease;
}

.site-header.scrolled .site-header-inner {
  padding: 0;
  align-items: center;
}

.header-right {
  display: flex;
  align-items: baseline;
  gap: 32px;
}

.brand-group {
  display: flex;
  flex-direction: column;
  gap: 4px;
  transition: gap 0.3s ease;
}

.site-header.scrolled .brand-group {
  gap: 0;
}

.brand {
  font-weight: 500;
  letter-spacing: -0.01em;
  line-height: 1;
}

.brand-meta {
  display: flex;
  gap: 8px;
  align-items: center;
  font-size: 16px;
  color: var(--muted);
  font-weight: 500;
  line-height: 1;
  opacity: 1;
  transition: opacity 0.3s ease, font-size 0.3s ease;
}

.site-header.scrolled .brand-meta {
  opacity: 0;
  font-size: 0;
  pointer-events: none;
}

.brand-meta .dot {
  opacity: 0.6;
}

.brand-meta [data-clock] {
  font-variant-numeric: tabular-nums;
}

.nav {
  display: flex;
  gap: 24px;
  font-family: var(--mono);
  font-size: 14px;
  color: var(--muted);
  font-weight: 500;
}

.nav a.is-current {
  color: var(--fg);
}

.lang-switcher {
  display: flex;
  align-items: center;
  gap: 8px;
}

.lang-btn {
  background: none;
  border: none;
  font-family: var(--mono);
  font-size: 14px;
  font-weight: 500;
  color: var(--muted);
  cursor: pointer;
  padding: 0;
  transition: color 0.15s ease;
}

.lang-btn.active {
  color: var(--fg);
}

.lang-btn:hover {
  color: var(--fg);
}

.lang-divider {
  color: var(--muted);
  font-family: var(--mono);
  font-size: 14px;
}

/* Intro */
.intro {
  display: flex;
  flex-direction: column;
  gap: 16px;
  padding-top: 80px;
}

.intro-photos {
  padding-top: 80px;
}

.photos-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24px;
}

.side-photos-grid {
  display: grid;
  grid-template-columns: 1fr;
  grid-auto-rows: 1fr;
  gap: 24px;
  height: 100%;
}

.info-photo {
  width: 100%;
  height: auto;
  aspect-ratio: 1;
  object-fit: cover;
  border-radius: 8px;
  background: var(--rule);
}

.side-photos-grid .info-photo {
  aspect-ratio: auto;
}

.intro-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24px;
}

.title {
  font-size: 28px;
  font-weight: 500;
  letter-spacing: -0.02em;
  line-height: 1.2;
}

.availability {
  display: flex;
  flex-direction: column;
  gap: 4px;
  text-align: right;
}

.availability-status {
  display: flex;
  align-items: center;
  gap: 8px;
  color: #22c55e;
  font-family: var(--mono);
  font-size: 13px;
  font-weight: 500;
  white-space: nowrap;
  justify-content: flex-end;
}

.availability-text {
  font-weight: 500;
}

.availability-date {
  color: var(--muted);
  font-family: var(--mono);
  font-size: 13px;
  font-weight: 500;
  margin-top: 4px;
}

.contact-link {
  color: var(--fg);
  font-family: var(--mono);
  font-size: 15px;
  font-weight: 500;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  transition: all 0.3s ease;
  white-space: nowrap;
  position: relative;
  padding-bottom: 4px;
}

.contact-link::before {
  content: "";
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 1px;
  background: var(--fg);
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.3s ease;
}

.contact-link:hover::before {
  transform: scaleX(1);
}

.contact-link::after {
  content: "";
  width: 20px;
  height: 20px;
  display: inline-block;
  background: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="%23111111" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>') no-repeat center;
  background-size: contain;
  transition: transform 0.3s ease;
}

.contact-link:hover::after {
  transform: rotate(-45deg) translateY(-2px);
}

.availability-dot {
  width: 8px;
  height: 8px;
  background: #22c55e;
  border-radius: 50%;
  display: inline-block;
  animation: blink 1.5s infinite;
}

@keyframes blink {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: 0.3;
  }
}

/* Floating Button */
.floating-button {
  position: fixed;
  bottom: 32px;
  right: 32px;
  background: #111111;
  color: white;
  padding: 16px 24px;
  border-radius: 50px;
  display: flex;
  align-items: center;
  gap: 12px;
  font-family: var(--mono);
  font-size: 14px;
  font-weight: 500;
  text-decoration: none;
  z-index: 997;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.4s ease, transform 0.4s ease, background 0.3s ease, color 0.3s ease;
  transform: translateY(20px);
}

.floating-button.visible {
  opacity: 1;
  pointer-events: all;
  transform: translateY(0);
}

.floating-button:hover {
  background: white;
  color: #111111;
}

.floating-button:hover .floating-arrow {
  transform: rotate(-45deg);
}

.floating-dot {
  width: 8px;
  height: 8px;
  background: #22c55e;
  border-radius: 50%;
  display: inline-block;
  animation: blink 1.5s infinite;
}

.floating-arrow {
  width: 16px;
  height: 16px;
  transition: transform 0.3s ease;
}

.intro-bottom {
  display: flex;
  justify-content: space-between;
  gap: 24px;
  align-items: flex-end;
}

.lede {
  font-size: 18px;
  color: var(--fg);
  max-width: 56ch;
  line-height: 1.55;
}

.hero-video {
  width: 100%;
  margin-top: 32px;
  cursor: pointer;
  transition: transform 0.6s ease;
}

.hero-video.expanded {
  transform: scale(1.08);
}

.hero-video video {
  width: 100%;
  height: auto;
  max-width: 1320px;
  display: block;
  border-radius: 8px;
  background: #000;
}

/* Sections */
.section-label {
  font-family: var(--mono);
  font-size: 13px;
  font-weight: 400;
  color: var(--muted);
  text-transform: none;
  margin-bottom: 16px;
}

.info-right .section-label {
  color: var(--fg);
  font-weight: 500;
  font-size: 16px;
}

.work {
  margin-top: 80px;
}

.work > .section-label {
  font-family: var(--sans);
  font-size: 48px;
  font-weight: 500;
  color: var(--fg);
}

/* Work grid */
.work {
  display: flex;
  flex-direction: column;
}

.work-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 32px;
  margin-top: 32px;
}

.work-card-wrapper {
  display: flex;
  flex-direction: column;
}

.work-card {
  display: block;
  width: 100%;
  height: 400px;
  background: var(--rule);
  border-radius: 8px;
  transition: opacity 0.15s ease;
  text-decoration: none;
}

.work-card:hover {
  opacity: 0.8;
}

.work-card-title {
  font-size: 16px;
  font-weight: 500;
  color: var(--fg);
  margin: 16px 0 0 0;
}

.work-card-description {
  font-size: 16px;
  font-weight: 500;
  color: var(--muted);
  margin: 4px 0 0 0;
}

/* Information page */
.info {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24px;
  align-items: stretch;
}

.info-left {
  display: flex;
  flex-direction: column;
  height: 100%;
}

.info-right {
  display: flex;
  flex-direction: column;
  gap: 48px;
  grid-column: 2;
}

.info-block p {
  max-width: 60ch;
}

.plain-list {
  list-style: none;
  display: flex;
  flex-direction: column;
  border-top: 1px solid var(--rule);
}

.plain-list li {
  display: flex;
  justify-content: space-between;
  gap: 24px;
  padding: 14px 0;
  border-bottom: 1px solid var(--rule);
  font-size: 15px;
}

.plain-list li span:last-child {
  color: var(--muted);
  font-family: var(--mono);
  font-size: 13px;
}

.experience-list {
  display: flex;
  flex-direction: column;
  border-top: 1px solid var(--rule);
}

.experience-item {
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding: 14px 0;
  border-bottom: 1px solid var(--rule);
}

.experience-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 16px;
}

.experience-role {
  color: var(--fg);
  font-weight: 500;
  font-size: 15px;
}

.experience-company {
  color: var(--muted);
  font-family: var(--mono);
  font-size: 13px;
}

.experience-year {
  color: var(--muted);
  font-family: var(--mono);
  font-size: 13px;
}

/* Footer */
.site-footer {
  width: 100%;
  border-top: 1px solid var(--rule);
  padding: 32px 0 64px 0;
  font-family: var(--mono);
  font-size: 13px;
  color: var(--muted);
}

.footer-inner {
  max-width: 1320px;
  margin: 0 auto;
  padding: 0 32px;
  display: flex;
  justify-content: space-between;
  gap: 32px;
}

.footer-section {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.footer-section-title {
  color: var(--fg);
  font-weight: 500;
}

.footer-social .footer-section-title,
.footer-design .footer-section-title,
.footer-email .footer-section-title {
  margin-bottom: 8px;
}

.email {
  color: var(--fg);
  font-family: var(--mono);
}

.social {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.social a {
  color: var(--fg);
  font-weight: 500;
  text-decoration: underline;
  text-decoration-color: var(--muted);
  text-underline-offset: 4px;
}

/* Small screens */
@media (max-width: 560px) {
  .page {
    padding: 32px 20px 48px;
    gap: 64px;
  }

  .site-header {
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }

  .title {
    font-size: 24px;
  }

  .lede {
    font-size: 16px;
  }

  .work-item {
    grid-template-columns: 1fr auto;
  }

  .work-client {
    grid-column: 1 / 2;
    font-size: 14px;
  }
}
